<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/output.css">
    <link rel="stylesheet" href="/portfolio.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;900&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Three.js Canvas Background -->
    <canvas id="three-canvas"></canvas>

    <!-- Smooth Scroll Container -->
    <div data-scroll-container>

        <!-- Navigation -->
        <nav class="nav-bar">
            <div class="nav-content">
                <a href="#" class="logo">Portfolio</a>
                <div class="nav-links">
                    <a href="#about" data-scroll-to>About</a>
                    <a href="#projects" data-scroll-to>Projects</a>
                    <a href="#skills" data-scroll-to>Skills</a>
                    <a href="#contact" data-scroll-to>Contact</a>
                </div>
            </div>
        </nav>

        <!-- Hero Section -->
        <section class="hero-section" id="hero" data-scroll-section>
            <div class="hero-content">
                <h1 class="hero-title" data-scroll data-scroll-speed="2">
                    <span class="title-line">Hi, I'm</span>
                    <span class="title-name"><%= name %></span>
                </h1>
                <p class="hero-tagline" data-scroll data-scroll-speed="1" data-scroll-delay="0.1">
                    <%= tagline %>
                </p>
                <div class="hero-cta" data-scroll data-scroll-speed="1" data-scroll-delay="0.2">
                    <a href="#projects" class="btn-primary">View My Work</a>
                    <a href="#contact" class="btn-secondary">Get In Touch</a>
                </div>
            </div>
            <div class="scroll-indicator" data-scroll data-scroll-speed="3">
                <div class="mouse"></div>
                <span>Scroll Down</span>
            </div>
        </section>

        <!-- About Section -->
        <section class="about-section" id="about" data-scroll-section>
            <div class="section-container">
                <h2 class="section-title" data-scroll data-scroll-speed="1">
                    About Me
                </h2>
                <div class="about-content">
                    <div class="about-text" data-scroll data-scroll-speed="0.5">
                        <p class="about-description">
                            <%= about %>
                        </p>
                        <p class="about-description">
                            I specialize in creating visually stunning and highly interactive web experiences
                            using modern technologies like Three.js, React, and GSAP. My passion lies in
                            pushing the boundaries of what's possible on the web.
                        </p>
                    </div>
                    <div class="about-stats" data-scroll data-scroll-speed="0.8">
                        <div class="stat-item">
                            <h3 class="stat-number">50+</h3>
                            <p class="stat-label">Projects Completed</p>
                        </div>
                        <div class="stat-item">
                            <h3 class="stat-number">5+</h3>
                            <p class="stat-label">Years Experience</p>
                        </div>
                        <div class="stat-item">
                            <h3 class="stat-number">30+</h3>
                            <p class="stat-label">Happy Clients</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Projects Section -->
        <section class="projects-section" id="projects" data-scroll-section>
            <div class="section-container">
                <h2 class="section-title" data-scroll data-scroll-speed="1">
                    Featured Projects
                </h2>
                <div class="projects-grid">
                    <% projects.forEach((project, index) => { %>
                        <div class="project-card" data-scroll data-scroll-speed="<%= (index % 2 === 0) ? '0.5' : '0.8' %>">
                            <div class="project-number">0<%= index + 1 %></div>
                            <h3 class="project-title"><%= project.title %></h3>
                            <p class="project-description"><%= project.description %></p>
                            <div class="project-tech">
                                <% project.tech.forEach(tech => { %>
                                    <span class="tech-tag"><%= tech %></span>
                                <% }); %>
                            </div>
                            <div class="project-links">
                                <a href="#" class="project-link">View Project →</a>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </section>

        <!-- Skills Section -->
        <section class="skills-section" id="skills" data-scroll-section>
            <div class="section-container">
                <h2 class="section-title" data-scroll data-scroll-speed="1">
                    Skills & Technologies
                </h2>
                <div class="skills-grid">
                    <% skills.forEach((skill, index) => { %>
                        <div class="skill-item"
                             data-scroll
                             data-scroll-speed="<%= 0.5 + (index * 0.1) %>"
                             style="animation-delay: <%= index * 0.1 %>s">
                            <%= skill %>
                        </div>
                    <% }); %>
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <section class="contact-section" id="contact" data-scroll-section>
            <div class="section-container">
                <h2 class="section-title" data-scroll data-scroll-speed="1">
                    Let's Work Together
                </h2>
                <div class="contact-content" data-scroll data-scroll-speed="0.5">
                    <p class="contact-text">
                        I'm always open to discussing new projects, creative ideas, or opportunities to be part of your vision.
                    </p>
                    <div class="contact-links">
                        <a href="mailto:<%= email %>" class="contact-link">
                            <span class="contact-icon">✉</span>
                            <%= email %>
                        </a>
                        <a href="<%= github %>" target="_blank" class="contact-link">
                            <span class="contact-icon">🔗</span>
                            GitHub
                        </a>
                        <a href="<%= linkedin %>" target="_blank" class="contact-link">
                            <span class="contact-icon">💼</span>
                            LinkedIn
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="footer" data-scroll-section>
            <div class="footer-content">
                <p>&copy; 2024 <%= name %>. All rights reserved.</p>
                <p>Built with Three.js, GSAP, and Locomotive Scroll</p>
            </div>
        </footer>

    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/locomotive-scroll@4.1.4/dist/locomotive-scroll.min.js"></script>
    <script src="/portfolio.js"></script>
</body>
</html>
