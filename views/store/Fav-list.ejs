<%- include('../partials/head') %>

    </head>

    <body class="bg-gradient-to-br from-amber-50 via-white to-amber-50 min-h-screen flex flex-col">
        <%- include('../partials/nav') %>

            <main class="flex-1 p-6 max-w-6xl mx-auto">
                <div class="bg-white rounded-xl shadow-lg p-8">
                    <h1 class="text-3xl font-bold text-amber-700 mb-6 text-center">Your Favourites</h1>

                    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10  mx-auto ">
                        <% registerHomes.forEach(home=> { %>
                            <li
                                class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition duration-300 w-80 mx-auto">

                                <!-- Image Section -->
                                <div class="h-48 bg-cover bg-center relative group"
                                    style="background-image: url('<%=home.url%>');">
                                    <div class="absolute inset-0 bg-black/20 group-hover:bg-black/30 transition"></div>
                                </div>

                                <!-- Content Section -->
                                <div class="p-5 space-y-3">
                                    <span class="block text-xl font-semibold text-gray-900">
                                        <%= home.houseName %>
                                    </span>
                                    <h2 class="text-lg font-bold text-amber-600 uppercase tracking-wide">
                                        <%= home.location %>
                                    </h2>

                                    <!-- Price & Rating -->
                                    <div class="flex items-center justify-between text-sm font-medium text-gray-700">
                                        <span class="text-amber-600 text-base font-semibold">
                                            <%= home.price %>$/night
                                        </span>
                                        <span class="flex items-center gap-1 text-yellow-500">
                                            <%= home.rating %>
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current"
                                                    viewBox="0 0 20 20">
                                                    <path
                                                        d="M10 15l-5.878 3.09L5.82 12 1 7.91l6.06-.91L10 2l2.94 5 6.06.91L14.18 12l1.698 6.09z" />
                                                </svg>
                                        </span>
                                    </div>

                                    <!-- Book Button -->
                                    <button
                                        class="w-full bg-amber-500 hover:bg-amber-600 text-white font-semibold py-2 px-4 rounded-xl transition">
                                        Book Now
                                    </button>
                                </div>
                            </li>
                            <% }) %>
                    </ul>


                </div>
            </main>
    </body>

    </html>